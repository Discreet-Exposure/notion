    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "openai-model",
      "name": "OpenAI GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [2420, 500],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIALS_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI agent's response to extract the JSON\nconst agentOutput = $('AI Content Analyzer').first().json.output;\n\n// Try to parse JSON from the response\nlet parsed;\ntry {\n  // Handle if response is already an object\n  if (typeof agentOutput === 'object') {\n    parsed = agentOutput;\n  } else {\n    // Try to extract JSON from text response\n    const jsonMatch = agentOutput.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      parsed = JSON.parse(jsonMatch[0]);\n    } else {\n      throw new Error('No JSON found in response');\n    }\n  }\n} catch (e) {\n  // Fallback with defaults\n  parsed = {\n    title: $('Prepare Context').first().json.rawText?.substring(0, 50) || 'Untitled Entry',\n    url: null,\n    category: 'Notes',\n    tags: ['uncategorized'],\n    description: $('Prepare Context').first().json.rawText || 'No description available',\n    isTask: false,\n    dueDate: null,\n    priority: null\n  };\n}\n\n// Ensure all required fields exist\nconst result = {\n  title: parsed.title || 'Untitled Entry',\n  url: parsed.url || null,\n  category: parsed.category || 'Notes',\n  tags: Array.isArray(parsed.tags) ? parsed.tags : ['uncategorized'],\n  description: parsed.description || '',\n  isTask: Boolean(parsed.isTask),\n  dueDate: parsed.dueDate || null,\n  priority: parsed.priority || null,\n  // Include original context\n  contentType: $('Prepare Context').first().json.contentType,\n  originalText: $('Prepare Context').first().json.rawText,\n  hasMedia: $('Prepare Context').first().json.hasMedia,\n  chatId: $('Prepare Context').first().json.chatId,\n  messageId: $('Prepare Context').first().json.messageId,\n  createdAt: $('Prepare Context').first().json.timestamp\n};\n\nreturn { json: result };"
      },
