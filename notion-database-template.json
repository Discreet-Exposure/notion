{
  "title": "Notebook",
  "description": "AI-powered notebook for capturing ideas, links, tasks, and media from Telegram",
  "properties": {
    "Name": {
      "type": "title",
      "description": "The title of the entry (auto-generated by AI)"
    },
    "URL": {
      "type": "url",
      "description": "Link URL if the entry contains a web link"
    },
    "Category": {
      "type": "select",
      "description": "Content category",
      "options": [
        { "name": "Articles", "color": "blue" },
        { "name": "Resources", "color": "green" },
        { "name": "Ideas", "color": "yellow" },
        { "name": "Tasks", "color": "red" },
        { "name": "Notes", "color": "gray" },
        { "name": "Projects", "color": "purple" },
        { "name": "References", "color": "orange" },
        { "name": "Learning", "color": "pink" },
        { "name": "Entertainment", "color": "brown" },
        { "name": "Work", "color": "blue" },
        { "name": "Personal", "color": "green" },
        { "name": "Bookmarks", "color": "default" },
        { "name": "Recipes", "color": "orange" },
        { "name": "Travel", "color": "blue" },
        { "name": "Health", "color": "green" },
        { "name": "Finance", "color": "yellow" }
      ]
    },
    "Tags": {
      "type": "multi_select",
      "description": "Relevant tags for the entry (AI will create new ones as needed)",
      "options": [
        { "name": "important", "color": "red" },
        { "name": "read-later", "color": "blue" },
        { "name": "follow-up", "color": "orange" },
        { "name": "research", "color": "purple" },
        { "name": "inspiration", "color": "pink" },
        { "name": "reference", "color": "gray" },
        { "name": "tutorial", "color": "green" },
        { "name": "tool", "color": "yellow" },
        { "name": "productivity", "color": "blue" },
        { "name": "coding", "color": "purple" },
        { "name": "design", "color": "pink" },
        { "name": "business", "color": "orange" },
        { "name": "ai", "color": "blue" },
        { "name": "automation", "color": "green" },
        { "name": "writing", "color": "gray" },
        { "name": "meeting-notes", "color": "yellow" },
        { "name": "quick-thought", "color": "default" },
        { "name": "bookmark", "color": "brown" }
      ]
    },
    "Description": {
      "type": "rich_text",
      "description": "AI-generated description of the content"
    },
    "Created": {
      "type": "date",
      "description": "When the entry was received from Telegram"
    },
    "Is Task": {
      "type": "checkbox",
      "description": "Whether this entry represents a task or to-do item"
    },
    "Due Date": {
      "type": "date",
      "description": "Due date for tasks (if applicable)"
    },
    "Priority": {
      "type": "select",
      "description": "Priority level for tasks",
      "options": [
        { "name": "High", "color": "red" },
        { "name": "Medium", "color": "yellow" },
        { "name": "Low", "color": "green" }
      ]
    },
    "Content Type": {
      "type": "select",
      "description": "The type of content received from Telegram",
      "options": [
        { "name": "Link", "color": "blue" },
        { "name": "Text Message", "color": "gray" },
        { "name": "Voice Note", "color": "purple" },
        { "name": "Image", "color": "pink" },
        { "name": "Video", "color": "red" },
        { "name": "Document", "color": "orange" },
        { "name": "Audio", "color": "green" }
      ]
    },
    "Source": {
      "type": "rich_text",
      "description": "Where the entry came from (always 'Telegram' for this workflow)"
    },
    "Status": {
      "type": "select",
      "description": "Processing/completion status",
      "options": [
        { "name": "New", "color": "blue" },
        { "name": "In Progress", "color": "yellow" },
        { "name": "Completed", "color": "green" },
        { "name": "On Hold", "color": "gray" },
        { "name": "Archived", "color": "default" }
      ]
    }
  },
  "views": {
    "default": {
      "type": "table",
      "name": "All Entries",
      "columns": ["Name", "Category", "Tags", "Created", "Is Task", "Due Date"]
    },
    "tasks": {
      "type": "board",
      "name": "Tasks Board",
      "groupBy": "Status",
      "filter": {
        "property": "Is Task",
        "equals": true
      }
    },
    "byCategory": {
      "type": "gallery",
      "name": "By Category",
      "groupBy": "Category"
    },
    "calendar": {
      "type": "calendar",
      "name": "Due Dates",
      "dateProperty": "Due Date"
    },
    "recentLinks": {
      "type": "list",
      "name": "Recent Links",
      "filter": {
        "property": "Content Type",
        "equals": "Link"
      },
      "sort": {
        "property": "Created",
        "direction": "descending"
      }
    }
  },
  "setup_instructions": [
    "1. Create a new database in Notion",
    "2. Name it 'Notebook'",
    "3. Add all properties listed above with the correct types",
    "4. Create the select/multi-select options as listed",
    "5. Share the database with your n8n integration",
    "6. Copy the database ID from the URL for use in n8n"
  ]
}
